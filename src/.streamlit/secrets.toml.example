# Copy this file to src/.streamlit/secrets.toml and fill in your own project's values.
# secrets.toml is gitignored. NEVER commit real keys or paste them in chat.
# Supabase dashboard -> Project Settings -> API.

[supabase]
url = "https://YOUR-PROJECT-REF.supabase.co"

# Public "anon" key: used by every signed-in user's client.
anon_key = "YOUR-ANON-KEY"

# Service-role key: bypasses row level security. Used ONLY to delete accounts and by
# the dev seed scripts. Leave it out of any deployment that does not need it.
service_key = "YOUR-SERVICE-ROLE-KEY"
